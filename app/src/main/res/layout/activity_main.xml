<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fillViewport="true"
    android:background="@drawable/inventario">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center">

        <!-- Espaciador superior -->
        <View
            android:layout_width="match_parent"
            android:layout_height="20dp"/>

        <!-- Header Card mejorado con animación -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:elevation="12dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="#00000000">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp"
                android:background="@drawable/gradient_header"
                android:gravity="center">

                <!-- Icono con efecto circular -->
                <FrameLayout
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/circle_white_bg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="🗂️"
                        android:textSize="48sp"/>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INVENTARIO"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:letterSpacing="0.08"
                    android:shadowColor="#40000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gestión de productos"
                    android:textSize="15sp"
                    android:textColor="#F0FFFFFF"
                    android:layout_marginTop="6dp"
                    android:letterSpacing="0.05"/>

                <!-- Línea decorativa -->
                <View
                    android:layout_width="80dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="12dp"
                    android:background="#40FFFFFF"
                    android:alpha="0.8"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Grid 2x2 con CardViews mejorados -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false"
            android:layout_marginBottom="20dp">

            <!-- Registrar Producto -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:elevation="8dp"
                app:cardCornerRadius="24dp"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:id="@+id/btnRegistrar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/btn_agregar_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="20dp">

                    <!-- Círculo decorativo detrás del icono -->
                    <FrameLayout
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:background="@drawable/circle_icon_bg"
                        android:backgroundTint="#4DFFFFFF"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="➕"
                            android:textSize="32sp"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Agregar"
                        android:textSize="19sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:shadowColor="#40000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="2"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nuevo producto"
                        android:textSize="11sp"
                        android:textColor="#E5F5FF"
                        android:layout_marginTop="4dp"
                        android:alpha="0.9"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Listar Productos -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:elevation="8dp"
                app:cardCornerRadius="24dp"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:id="@+id/btnListar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/btn_listar_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="20dp">

                    <FrameLayout
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:background="@drawable/circle_icon_bg"
                        android:backgroundTint="#4DFFFFFF"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="📦"
                            android:textSize="32sp"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ver Todos"
                        android:textSize="19sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:shadowColor="#40000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="2"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lista completa"
                        android:textSize="11sp"
                        android:textColor="#E5FFF0"
                        android:layout_marginTop="4dp"
                        android:alpha="0.9"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Buscar/Editar -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:elevation="8dp"
                app:cardCornerRadius="24dp"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:id="@+id/btnConsultar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/btn_buscar_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="20dp">

                    <FrameLayout
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:background="@drawable/circle_icon_bg"
                        android:backgroundTint="#4DFFFFFF"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🕵️‍♀️"
                            android:textSize="32sp"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Buscar"
                        android:textSize="19sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:shadowColor="#40000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="2"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Buscar y editar"
                        android:textSize="11sp"
                        android:textColor="#F5E5FF"
                        android:layout_marginTop="4dp"
                        android:alpha="0.9"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Stock Bajo -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:elevation="8dp"
                app:cardCornerRadius="24dp"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:id="@+id/btnStockBajo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/btn_stock_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="20dp">

                    <FrameLayout
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:background="@drawable/circle_icon_bg"
                        android:backgroundTint="#4DFFFFFF"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🚨"
                            android:textSize="32sp"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stock Bajo"
                        android:textSize="19sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:shadowColor="#40000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="2"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alertas"
                        android:textSize="11sp"
                        android:textColor="#FFE5E5"
                        android:layout_marginTop="4dp"
                        android:alpha="0.9"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </GridLayout>

        <!-- Info footer opcional -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:background="@drawable/info_footer_bg"
            android:alpha="0.85">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡"
                android:textSize="16sp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Toca cualquier opción para comenzar"
                android:textSize="13sp"
                android:textColor="#5D4037"
                android:textStyle="italic"/>
        </LinearLayout>

        <!-- Espaciador inferior -->
        <View
            android:layout_width="match_parent"
            android:layout_height="20dp"/>

    </LinearLayout>
</ScrollView>